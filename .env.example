# Required
API_KEY=your-secure-api-key-here
PHONE_NUMBER=628xxxxxxxxxx

# Optional
PORT=3001
AUTH_DIR=./auth_info

# Anti-Banned Settings
MIN_DELAY=15000
MAX_DELAY=35000
MAX_PER_HOUR=10
MAX_PER_DAY=50

# Jam Operasional (0-24)
OPERATING_START=0
OPERATING_END=24

# Retry
RETRY_DELAY=60000
MAX_RETRIES=3

# Logging
LOG_LEVEL=info
